# =====================================================================
#  CKAN Docker per l'Italia — configurazione per le immagini Docker Hub
#  (da usare con docker-compose.hub.yml, senza build).
#  Copiare in `.env` e modificare SOLO il blocco "DA MODIFICARE".
#  Tutto il resto ha default sensati per un test locale.
# =====================================================================

# ---------------------------------------------------------------------
#  >>> DA MODIFICARE <<<
# ---------------------------------------------------------------------
# URL pubblico del portale. NIENTE slash finale.
#   - Test locale via NGINX in HTTP : http://localhost:8080
#   - Test locale via NGINX in HTTPS: https://localhost:8443
#   - IP privato                    : http://192.168.1.50:8080
#   - Produzione                    : https://dati.miocomune.it
# Da questo valore vengono derivati automaticamente, a runtime:
#   ckanext.dcat.base_uri  e  ckan.oaipmh.base_url (vedi sotto).
CKAN_SITE_URL=http://localhost:8080

# Password del primo amministratore (l'utente e' CKAN_SYSADMIN_NAME).
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=CHANGE_ME_admin_pwd
CKAN_SYSADMIN_EMAIL=admin@example.com

# Email dell'amministratore esposta nella risposta OAI-PMH Identify
# (vuoto = CKAN_SYSADMIN_EMAIL)
CKAN_OAIPMH_ADMIN_EMAIL=

# Segreti applicativi: NON servono. Se non sono impostati vengono generati
# al primo avvio e conservati nel volume ckan_storage.
# Per fissarli a mano decommentare e valorizzare TUTTE e quattro le righe:
#   python3 -c "import secrets; print(secrets.token_urlsafe())"
#CKAN___SECRET_KEY=
#CKAN___WTF_CSRF_SECRET_KEY=
#CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:
#CKAN___API_TOKEN__JWT__DECODE__SECRET=string:

# Creazione automatica dei gruppi tematici DCAT-AP_IT al primo avvio
CKAN_SETUP_GROUPS=true

# Username GeoNames per il geocoding spaziale (default: demo, limitato).
GEONAMES_USERNAME=demo

# ---------------------------------------------------------------------
#  Versione delle immagini Docker Hub (piersoft/ckan, ckan-solr, ckan-db,
#  ckan-nginx). 2.12 = ultima 2.12; per bloccarla: es. 2.12-dcatapit-1.0.0
# ---------------------------------------------------------------------
CKAN_ITA_TAG=2.12

# Nome del progetto Compose: prefissa container, reti e volumi.
COMPOSE_PROJECT_NAME=ckan

# ---------------------------------------------------------------------
#  Porte pubblicate sull'host
# ---------------------------------------------------------------------
# Accesso NON-SSL  -> http://<host>:${NGINX_PORT_HOST}
NGINX_PORT_HOST=8080
# Accesso SSL      -> https://<host>:${NGINX_SSLPORT_HOST}  (cert self-signed)
NGINX_SSLPORT_HOST=8443

# -------------------------------------------------------------------------------------------------------------------------
#  Database PostgreSQL  (PG16 -> richiede ?sslmode=disable negli URL). Se PG è SaaS su altra macchina ?sslmode=require !!!!
#  In produzione cambiare le password e riportarle anche nei tre URL qui sotto.
# -------------------------------------------------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore

CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb?sslmode=disable
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore?sslmode=disable
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore?sslmode=disable

# Database di test (usati solo dai test automatici)
TEST_CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckan_test?sslmode=disable
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore_test?sslmode=disable
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test?sslmode=disable

# ---------------------------------------------------------------------
#  CKAN core
# ---------------------------------------------------------------------
CKAN_VERSION=2.12.0
CKAN_SITE_ID=default
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_LOCALE_DEFAULT=it
TZ=Europe/Rome

# DCAT: base_uri e profili. base_uri viene comunque riallineato a
# CKAN_SITE_URL a runtime dallo script 02_ckan-init.sh.
CKANEXT__DCAT__BASE__URI=http://localhost:8080
# Badge con il punteggio MQA di data.europa.eu nella pagina dataset (solo se il
# catalogo e' harvestato dal portale europeo): true per attivarlo.
CKANEXT__DCATITA__MQA_BADGE=false
# dct:relation di ripiego: ricerca dei dataset dello stesso titolare (holder_name).
# Vuoto = ricerca CKAN del portale: {site_url}/dataset/?holder_name={holder}
# Segnaposto: {site_url}, {holder} (codificato), {qholder} (tra virgolette, codificato).
# dati.gov.it: https://www.dati.gov.it/view-dataset?holder_name={qholder}
CKANEXT__DCATITA__RELATION_URL=
# Dichiarazione di accessibilita' (obbligatoria per le PA, Linee guida AgID):
# URL della dichiarazione pubblicata su form.agid.gov.it. Se valorizzato, il
# footer mostra il link "Dichiarazione di accessibilita'". Vuoto = nessun link.
CKANEXT__DCATITA__ACCESSIBILITY_STATEMENT_URL=
# CSS predefinito accessibile (ckan/css.example): impostato come "Custom CSS"
# all'avvio se l'admin non ne ha uno proprio (script 04_custom_css.sh).
# false = non toccare mai il Custom CSS; CKAN_CUSTOM_CSS_FORCE=true lo
# sovrascrive con il predefinito al prossimo avvio (poi rimetterlo a false).
CKAN_CUSTOM_CSS_DEFAULT=true
CKAN_CUSTOM_CSS_FORCE=false

# Catena dei profili RDF. dcat_ita (ckanext-dcatita) va SEMPRE per ultimo.
# Senza il profilo MQA:  euro_dcat_ap_3 it_dcat_ap dcat_ita
CKANEXT__DCAT__RDF__PROFILES=dcat_ap_edp_mqa it_dcat_ap dcat_ita
# Export completo una tantum per data.europa.eu (harvest incrementale con modified_since):
# fino a questa data/ora UTC il parametro modified_since del catalogo viene ignorato e
# vengono esposti TUTTI i dataset. Vuoto = comportamento normale. Es. 2026-10-01T12:00
# (patch patches/ckanext-dcat-patches/05_full_export.patch)
CKANEXT__DCAT__FULL_EXPORT_UNTIL=

# OAI-PMH: se vuoto viene usato ${CKAN_SITE_URL}/oai (vedi 01_setup_xloader.sh)
CKAN_OAIPMH_BASE_URL=
CKANEXT__OAI_PMH_SERVER__RESUMPTION_TOKEN_BATCH_SIZE=1024
CKANEXT__OAI_PMH_SERVER__RESUMPTION_TOKEN_VALIDITY=36000000

# Datapusher / Xloader token header
CKAN_DATAPUSHER_API_TOKEN=X-CKAN-API-Key

CKANEXT__XLOADER__USE_TYPE_GUESSING=true
CKANEXT__XLOADER__STRICT_TYPE_GUESSING=false
CKANEXT__XLOADER__MAX_TYPE_GUESSING_LENGTH=104857600
CKANEXT__XLOADER__PARSE_DATES_DAYFIRST=true
# Dimensione massima delle risorse (MB). Rilevante anche per il type guessing: il default
# di max_type_guessing_length e' 1/10 di questo valore, quindi con 10 MB i file sopra 1 MB
# verrebbero caricati senza tipi.
CKAN___CKAN__MAX_RESOURCE_SIZE=200

# SMTP (opzionale, per le email)
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost

# ---------------------------------------------------------------------
#  Solr / Redis
# ---------------------------------------------------------------------
SOLR_IMAGE_VERSION=2.12-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan
REDIS_VERSION=7
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# ---------------------------------------------------------------------
#  Plugin attivi (l'ordine conta: multilang PRIMA di dcatapit_pkg, "first plugin wins"
#  per template e helper). Cambiare questa riga richiede `docker compose up -d ckan`.
#    core:      datatables_view image_view text_view datastore xloader activity
#    harvest:   harvest ckan_harvester
#    dcat:      dcat dcat_rdf_harvester dcat_json_harvester dcat_json_interface structured_data
#    dcatita:   dcatita_harvest dcatita_uri
#    dcatapit:  multilang dcatapit_pkg dcatapit_org dcatapit_config dcatapit_theme_group_mapper
#    facoltativi: dcat_ap_edp_mqa (profilo MQA data.europa.eu; se lo togli usa
#                 "euro_dcat_ap_3 it_dcat_ap dcat_ita" nei profili), oai_pmh_server (OpenAIRE)
# ---------------------------------------------------------------------
CKAN__PLUGINS=envvars datatables_view image_view text_view datastore xloader activity harvest ckan_harvester dcat dcat_rdf_harvester dcat_json_harvester dcat_json_interface structured_data dcatita_harvest dcatita_uri multilang dcatapit_pkg dcatapit_org dcatapit_config dcatapit_theme_group_mapper dcat_ap_edp_mqa oai_pmh_server
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1

# ---------------------------------------------------------------------
#  uWSGI: timeout estesi per la generazione di catalog.rdf/ttl grandi
# ---------------------------------------------------------------------
UWSGI_HARAKIRI=500
EXTRA_UWSGI_OPTS=--http-timeout 600 --socket-timeout 600 --ignore-sigpipe --ignore-write-errors --disable-write-exception

# Dev
USE_HTTPS_FOR_DEV=false
