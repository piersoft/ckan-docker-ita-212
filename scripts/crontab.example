# Cron dell'host per ckan-docker-ita-212 — da aggiungere con `crontab -e` (root),
# adattando il percorso. I log vanno in /var/log/ckan212-maintenance.log.
DIR=/home/ubuntu/ckan-docker-ita-212
*/15 * * * *  $DIR/scripts/maintenance.sh harvest-run
# harvest di TUTTE le sorgenti attive ogni notte alle 01:00 (indipendente dalla frequenza
# impostata su ciascuna); commentare se si preferisce governare tutto con le frequenze
0 1 * * *     $DIR/scripts/maintenance.sh harvest-all
10 3 * * *    $DIR/scripts/maintenance.sh daily
30 4 * * 0    $DIR/scripts/maintenance.sh weekly
# Ricarica nel DataStore le risorse gia' caricate: necessario sui cataloghi harvestati,
# dove l'URL della risorsa e' persistente ma il contenuto del CSV cambia (altrimenti
# l'anteprima resta obsoleta). Pesante: riscarica ogni file. Cadenza consigliata:
#   - contenuti che cambiano ogni giorno  -> notturno, dopo l'harvest
#   - contenuti che cambiano di rado      -> settimanale (riga sotto)
30 2 * * *    $DIR/scripts/maintenance.sh xloader-refresh
# 30 2 * * 0  $DIR/scripts/maintenance.sh xloader-refresh
# (la pulizia dei job xloader appesi e' gia' dentro `daily`, non serve una riga a parte)
