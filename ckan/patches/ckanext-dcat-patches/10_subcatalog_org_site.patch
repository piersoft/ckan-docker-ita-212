+    def _org_catalog_info(self, dataset_dict, site):
+        """ckan-docker-ita: metadati del sottocatalogo ricavati dall'organizzazione
+        (titolo, descrizione, lingua, editore con identificativo IPA e tipo ADMS),
+        per il caso in cui il sottocatalogo e' il suo `site`."""
+        org = dataset_dict.get('organization') or {}
+        org_id = org.get('id') or dataset_dict.get('owner_org')
+        if not org_id:
+            return None
+        if org_id not in self._ORG_INFO:
+            try:
+                full = p.toolkit.get_action('organization_show')(
+                    {'ignore_auth': True},
+                    {'id': org_id, 'include_datasets': False, 'include_users': False})
+            except Exception:
+                full = org
+            ident = (full.get('identifier') or '').strip()
+            ptype = ''
+            try:
+                from ckanext.dcatita import rules as _dcatita_rules
+                ptype = _dcatita_rules.publisher_type_from_ipa(ident) or ''
+            except Exception:
+                pass
+            title = full.get('title') or full.get('name') or 'Publisher'
+            self._ORG_INFO[org_id] = {
+                'source_catalog_title': title,
+                'source_catalog_description': (full.get('description') or '').strip() or title,
+                'source_catalog_language': 'ITA',
+                'source_catalog_publisher': json.dumps({
+                    'uri': '', 'name': title, 'email': '',
+                    'url': site, 'type': ptype}),
+                '_identifier': ident,
+            }
+        return self._ORG_INFO[org_id]
+
