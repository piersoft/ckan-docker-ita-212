+    def _org_subcatalog_ref(self, root_catalog_ref, dataset_dict):
+        """ckan-docker-ita: URI del subcatalog dell'organizzazione = suo campo `site`
+        (esposto da dcatapit come vcard:hasURL sul nodo organization)."""
+        org = dataset_dict.get('organization') or {}
+        org_id = org.get('id') or org.get('name') or dataset_dict.get('owner_org')
+        if not org_id:
+            return None
+        org_node = URIRef(str(root_catalog_ref).rstrip('/') + '/organization/' + str(org_id))
+        for site in self.g.objects(org_node, VCARD.hasURL):
+            return site
+        return None
+
